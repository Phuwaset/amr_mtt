<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_mtt_Gripper</name>
  <version>0.0.1</version>
  <description>Robotiq 2F-85 Gripper configuration for AMR MTT robot</description>
  <maintainer email="sphuwaset@example.com">sphuwaset_ros</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robotiq_description</depend>
  <depend>robotiq_controllers</depend>
  <depend>controller_manager</depend>
  <depend>rclpy</depend>

  <exec_depend>moveit_ros_planning_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
