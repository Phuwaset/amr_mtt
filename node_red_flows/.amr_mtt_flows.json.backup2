  {
    "id": "8140f96fba06283b",
    "type": "ui_button",
    "z": "7f25b3b6ca73783f",
    "name": "STOP",
    "group": "arm-ui-group-joints",
    "order": 8,
    "width": "6",
    "height": "1",
    "passthru": false,
    "label": "\u26d4 STOP",
    "tooltip": "\u0e2b\u0e22\u0e38\u0e14\u0e41\u0e02\u0e19 \u2014 \u0e17\u0e33\u0e07\u0e32\u0e19\u0e44\u0e14\u0e49\u0e41\u0e21\u0e49 ENABLE \u0e1b\u0e34\u0e14\u0e2d\u0e22\u0e39\u0e48",
    "color": "white",
    "bgcolor": "#d73a49",
    "icon": "",
    "x": 140,
    "y": 580,
    "wires": [
      [
        "fc2859ea9c3b63a8"
      ]
    ]
  },
  {
    "id": "fc2859ea9c3b63a8",
    "type": "function",
    "z": "7f25b3b6ca73783f",
    "name": "Build STOP Command",
    "func": "// STOP \u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e1c\u0e48\u0e32\u0e19 guard \u2014 \u0e17\u0e33\u0e07\u0e32\u0e19\u0e44\u0e14\u0e49\u0e40\u0e2a\u0e21\u0e2d\nvar currentPositions = flow.get('feedback_positions') || [0,0,0,0,0,0];\n\nvar cmd = {\n    \"op\": \"publish\",\n    \"topic\": \"/ur_arm_controller/joint_trajectory\",\n    \"type\": \"trajectory_msgs/JointTrajectory\",\n    \"msg\": {\n        \"header\": { \"stamp\": { \"sec\": 0, \"nanosec\": 0 }, \"frame_id\": \"\" },\n        \"joint_names\": [\n            \"ur5_shoulder_pan_joint\",\n            \"ur5_shoulder_lift_joint\",\n            \"ur5_elbow_joint\",\n            \"ur5_wrist_1_joint\",\n            \"ur5_wrist_2_joint\",\n            \"ur5_wrist_3_joint\"\n        ],\n        \"points\": [{\n            \"positions\": currentPositions,\n            \"velocities\": [0,0,0,0,0,0],\n            \"accelerations\": [],\n            \"effort\": [],\n            \"time_from_start\": { \"sec\": 0, \"nanosec\": 100000000 }\n        }]\n    }\n};\nmsg.payload = JSON.stringify(cmd);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 390,
    "y": 580,
    "wires": [
      [
        "c5d066a708c5f69f"
      ]
    ]
  },
  {
    "id": "d9061dd59dbdb359",
    "type": "function",
    "z": "7f25b3b6ca73783f",
    "name": "Build JointTrajectory",
    "func": "var joints = flow.get('joint_values') || [0.0, -1.5708, -1.5708, -3.159, 0.0, 0.0];\nvar duration = parseFloat(flow.get('traj_duration') || 2.0);\n\nvar cmd = {\n    \"op\": \"publish\",\n    \"topic\": \"/ur_arm_controller/joint_trajectory\",\n    \"type\": \"trajectory_msgs/JointTrajectory\",\n    \"msg\": {\n        \"header\": { \"stamp\": { \"sec\": 0, \"nanosec\": 0 }, \"frame_id\": \"\" },\n        \"joint_names\": [\n            \"ur5_shoulder_pan_joint\",\n            \"ur5_shoulder_lift_joint\",\n            \"ur5_elbow_joint\",\n            \"ur5_wrist_1_joint\",\n            \"ur5_wrist_2_joint\",\n            \"ur5_wrist_3_joint\"\n        ],\n        \"points\": [{\n            \"positions\": joints,\n            \"velocities\": [],\n            \"accelerations\": [],\n            \"effort\": [],\n            \"time_from_start\": {\n                \"sec\": Math.floor(duration),\n                \"nanosec\": Math.round((duration % 1) * 1e9)\n            }\n        }]\n    }\n};\n\nmsg.payload = JSON.stringify(cmd);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 390,
    "y": 540,
    "wires": [
      [
        "f534b346f02658c8",
        "f6dc7b61e0158d16"
      ]
    ]
  },
  {
    "id": "f6dc7b61e0158d16",
    "type": "debug",
    "z": "7f25b3b6ca73783f",
    "name": "Debug Sent Command",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 650,
