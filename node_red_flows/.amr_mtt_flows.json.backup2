  {
    "id": "f2c28c86b757bed1",
    "type": "function",
    "z": "7f25b3b6ca73783f",
    "name": "Parse /joint_states",
    "func": "try {\n    var data = JSON.parse(msg.payload);\n    if (!data.msg || !data.msg.name || !data.msg.position) return null;\n\n    var names = data.msg.name;\n    var positions = data.msg.position;\n\n    var ur5Joints = [\n        'ur5_shoulder_pan_joint',\n        'ur5_shoulder_lift_joint',\n        'ur5_elbow_joint',\n        'ur5_wrist_1_joint',\n        'ur5_wrist_2_joint',\n        'ur5_wrist_3_joint'\n    ];\n\n    var result = {};\n    for (var i = 0; i < names.length; i++) {\n        if (ur5Joints.includes(names[i])) {\n            result[names[i]] = parseFloat(positions[i]);\n        }\n    }\n\n    // Store current positions for STOP command\n    var ur5Positions = ur5Joints.map(function(jn) { return result[jn] || 0.0; });\n    flow.set('feedback_positions', ur5Positions);\n\n    var display = '';\n    var sliders = [null, null, null, null, null, null];\n    var shouldSync = flow.get('sync_sliders_now');\n\n    ur5Joints.forEach(function(jn, idx) {\n        var shortName = ['J1','J2','J3','J4','J5','J6'][idx];\n        var val = result[jn] || 0.0;\n        display += shortName + ': ' + val.toFixed(4) + ' rad\\n';\n        if (shouldSync) {\n            sliders[idx] = {payload: val};\n            flow.set('j'+(idx+1), val);\n        }\n    });\n\n    if (shouldSync) {\n        flow.set('joint_values', ur5Joints.map(function(jn){ return result[jn]||0; }));\n        flow.set('sync_sliders_now', false);\n    }\n\n    msg.payload = display.trim();\n    return [msg, sliders[0], sliders[1], sliders[2], sliders[3], sliders[4], sliders[5]];\n\n} catch(e) {\n    return null;\n}",
    "outputs": 7,
    "noerr": 0,
    "x": 390,
    "y": 1040,
    "wires": [
      [
        "6bb9c9201871f058",
        "7e6641bea452b3e3"
      ],
      [
        "b18fdef4d2b6a120"
      ],
      [
        "e78632b239307d61"
      ],
      [
        "1eb43eeb95815aa5"
      ],
