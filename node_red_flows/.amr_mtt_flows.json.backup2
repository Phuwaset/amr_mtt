  {
    "id": "64dcfc23a6901f04",
    "type": "function",
    "z": "7f25b3b6ca73783f",
    "name": "Collect Joint Values",
    "func": "flow.set(msg.topic, parseFloat(msg.payload));\n\nvar j1 = (flow.get('j1') !== undefined) ? flow.get('j1') : 0.0;\nvar j2 = (flow.get('j2') !== undefined) ? flow.get('j2') : -1.5708;\nvar j3 = (flow.get('j3') !== undefined) ? flow.get('j3') : -1.5708;\nvar j4 = (flow.get('j4') !== undefined) ? flow.get('j4') : -3.159;\nvar j5 = (flow.get('j5') !== undefined) ? flow.get('j5') : 0.0;\nvar j6 = (flow.get('j6') !== undefined) ? flow.get('j6') : 0.0;\n\nflow.set('joint_values', [j1, j2, j3, j4, j5, j6]);\n\nvar display = '';\ndisplay += 'J1: ' + j1.toFixed(4) + ' rad\\n';\ndisplay += 'J2: ' + j2.toFixed(4) + ' rad\\n';\ndisplay += 'J3: ' + j3.toFixed(4) + ' rad\\n';\ndisplay += 'J4: ' + j4.toFixed(4) + ' rad\\n';\ndisplay += 'J5: ' + j5.toFixed(4) + ' rad\\n';\ndisplay += 'J6: ' + j6.toFixed(4) + ' rad';\n\nmsg.payload = display;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 390,
    "y": 380,
    "wires": [
      [
        "eb7cae9aa0aa29bd",
        "efd6c5298e1fcce9"
      ]
    ]
  },
