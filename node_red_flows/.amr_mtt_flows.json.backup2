  {
    "id": "2e4976d8c68a5bc6",
    "type": "inject",
    "z": "4792cf662a67706e",
    "name": "Subscribe on Start",
    "props": [],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": 5,
    "topic": "",
    "x": 160,
    "y": 80,
    "wires": [
      [
        "5b2bb348e8489ade",
        "633c830e4d7e1c64"
      ]
    ]
  },
  {
    "id": "5b2bb348e8489ade",
    "type": "function",
    "z": "4792cf662a67706e",
    "name": "Subscribe /map",
    "func": "msg.payload = JSON.stringify({\n    \"op\": \"subscribe\",\n    \"topic\": \"/map\",\n    \"type\": \"nav_msgs/OccupancyGrid\",\n    \"throttle_rate\": 2000,\n    \"qos\": {\n        \"durability\": \"transient_local\",\n        \"reliability\": \"reliable\"\n    }\n});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 400,
    "y": 60,
    "wires": [
      [
        "3b317ba6475b9bf8"
      ]
    ]
  },
  {
    "id": "633c830e4d7e1c64",
    "type": "function",
    "z": "4792cf662a67706e",
    "name": "Subscribe /amcl_pose",
    "func": "msg.payload = JSON.stringify({\n    \"op\": \"subscribe\",\n    \"topic\": \"/amcl_pose\",\n    \"type\": \"geometry_msgs/PoseWithCovarianceStamped\"\n});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 400,
    "y": 100,
    "wires": [
      [
        "3b317ba6475b9bf8"
      ]
    ]
  },
  {
    "id": "3b317ba6475b9bf8",
    "type": "websocket out",
    "z": "4792cf662a67706e",
    "name": "Send to Rosbridge",
    "server": "",
    "client": "ws-rosbridge-client",
    "x": 640,
    "y": 80,
    "wires": []
  },
  {
    "id": "bded0ae0ab67b1fa",
    "type": "websocket in",
    "z": "4792cf662a67706e",
    "name": "Receive from Rosbridge",
    "server": "",
    "client": "ws-rosbridge-client",
    "x": 160,
    "y": 220,
    "wires": [
      [
        "f9f1514ed02ac3b6"
      ]
    ]
  },
  {
    "id": "f9f1514ed02ac3b6",
    "type": "function",
    "z": "4792cf662a67706e",
    "name": "Route by Topic",
    "func": "try {\n    var data = JSON.parse(msg.payload);\n\n    if (data.topic === '/map') {\n        if (data.msg && data.msg.info) {\n            var info = data.msg.info;\n            flow.set('map_width', info.width);\n            flow.set('map_height', info.height);\n            flow.set('map_resolution', info.resolution);\n            flow.set('map_origin_x', info.origin.position.x);\n            flow.set('map_origin_y', info.origin.position.y);\n            flow.set('map_data', data.msg.data);\n        }\n        // Send full map payload to canvas\n        msg.payload = {\n            type: 'map',\n            width: flow.get('map_width') || 0,\n            height: flow.get('map_height') || 0,\n            resolution: flow.get('map_resolution') || 0.05,\n            origin_x: flow.get('map_origin_x') || 0,\n            origin_y: flow.get('map_origin_y') || 0,\n            data: flow.get('map_data') || [],\n            robot_x: flow.get('robot_x') || 0,\n            robot_y: flow.get('robot_y') || 0,\n            robot_yaw: flow.get('robot_yaw') || 0\n        };\n        return [msg, null];\n\n    } else if (data.topic === '/amcl_pose') {\n        if (data.msg && data.msg.pose && data.msg.pose.pose) {\n            var pose = data.msg.pose.pose;\n            var rx = pose.position.x;\n            var ry = pose.position.y;\n            var qz = pose.orientation.z;\n            var qw = pose.orientation.w;\n            var yaw = Math.atan2(2.0 * qw * qz, 1.0 - 2.0 * qz * qz);\n            flow.set('robot_x', rx);\n            flow.set('robot_y', ry);\n            flow.set('robot_yaw', yaw);\n            msg.payload = {\n                type: 'pose',\n                robot_x: rx,\n                robot_y: ry,\n                robot_yaw: yaw\n            };\n            return [null, msg];\n        }\n    }\n    return [null, null];\n} catch(e) {\n    return [null, null];\n}",
    "outputs": 2,
    "noerr": 0,
    "x": 390,
    "y": 220,
    "wires": [
      [
        "4b665cb12407975d"
      ],
      [
        "4b665cb12407975d",
        "473dbb7be54dd806"
      ]
    ]
  },
  {
    "id": "4b665cb12407975d",
    "type": "ui_template",
    "z": "4792cf662a67706e",
    "group": "amr-map-group",
    "name": "SLAM Map Canvas",
    "order": 1,
    "width": "24",
    "height": "14",
    "format": "<style>\n  #slam-wrap { background:#1a1a2e; padding:8px; border-radius:8px; }\n  #slam-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }\n  #slam-title { color:#00ff88; font-weight:bold; font-size:14px; }\n  #map-status { color:#888; font-size:11px; }\n  #slam-canvas { width:100%; border:1px solid #333; border-radius:4px; background:#222; display:block; cursor:crosshair; }\n  #slam-legend { display:flex; gap:16px; margin-top:6px; font-size:11px; color:#aaa; }\n  #pose-info { margin-top:4px; font-size:12px; color:#00ff88; font-family:monospace; }\n</style>\n\n<div id=\"slam-wrap\">\n  <div id=\"slam-header\">\n    <span id=\"slam-title\">\ud83d\uddfa\ufe0f 2D SLAM Map</span>\n    <span id=\"map-status\">Waiting for /map...</span>\n  </div>\n  <canvas id=\"slam-canvas\" width=\"900\" height=\"520\"></canvas>\n  <div id=\"slam-legend\">\n    <span style=\"color:#ddd;\">\u2b1c Free</span>\n    <span style=\"color:#333;\">\u2b1b Obstacle</span>\n    <span style=\"color:#888;\">\u25aa Unknown</span>\n    <span style=\"color:#00ff88;\">\u25cf Robot</span>\n  </div>\n  <div id=\"pose-info\">X: \u2014  Y: \u2014  Yaw: \u2014</div>\n</div>\n\n<script>\n(function() {\n  var canvas = document.getElementById('slam-canvas');\n  var ctx    = canvas.getContext('2d');\n\n  var mapMeta  = null;   // { img, width, height, resolution, origin_x, origin_y }\n  var robot    = { x: 0, y: 0, yaw: 0 };\n\n  /* \u2500\u2500 Build ImageData from OccupancyGrid data \u2500\u2500 */\n  function buildMapImage(payload) {\n    var w    = payload.width;\n    var h    = payload.height;\n    var data = payload.data;\n    if (!w || !h || !data || data.length === 0) return;\n\n    var off    = document.createElement('canvas');\n    off.width  = w;\n    off.height = h;\n    var offCtx = off.getContext('2d');\n    var img    = offCtx.createImageData(w, h);\n\n    for (var i = 0; i < data.length; i++) {\n      var v = data[i];\n      var r, g, b;\n      if (v < 0)       { r=128; g=128; b=128; }   // unknown  \u2192 grey\n      else if (v < 50) { r=220; g=220; b=220; }   // free     \u2192 light\n      else             { r=30;  g=30;  b=40;  }   // occupied \u2192 dark\n\n      // OccupancyGrid: row 0 = bottom of world \u2192 flip Y\n      var row = h - 1 - Math.floor(i / w);\n      var col = i % w;\n      var idx = (row * w + col) * 4;\n      img.data[idx]     = r;\n      img.data[idx + 1] = g;\n      img.data[idx + 2] = b;\n      img.data[idx + 3] = 255;\n    }\n    offCtx.putImageData(img, 0, 0);\n\n    mapMeta = {\n      img       : off,\n      width     : w,\n      height    : h,\n      resolution: payload.resolution,\n      origin_x  : payload.origin_x,\n      origin_y  : payload.origin_y\n    };\n\n    var status = document.getElementById('map-status');\n    if (status) status.textContent =\n      w + '\u00d7' + h + ' cells  \u2022  ' + (payload.resolution * 100).toFixed(1) + ' cm/cell';\n  }\n\n  /* \u2500\u2500 Render map + robot onto main canvas \u2500\u2500 */\n  function render() {\n    var cw = canvas.width;\n    var ch = canvas.height;\n    ctx.fillStyle = '#222';\n    ctx.fillRect(0, 0, cw, ch);\n\n    if (!mapMeta) return;\n\n    // Fit map into canvas with padding\n    var pad   = 10;\n    var scale = Math.min((cw - pad * 2) / mapMeta.width,\n                         (ch - pad * 2) / mapMeta.height);\n    var offX  = (cw - mapMeta.width  * scale) / 2;\n    var offY  = (ch - mapMeta.height * scale) / 2;\n\n    // Draw map image\n    ctx.imageSmoothingEnabled = false;\n    ctx.drawImage(mapMeta.img, offX, offY, mapMeta.width * scale, mapMeta.height * scale);\n\n    // Draw grid overlay (faint)\n    ctx.strokeStyle = 'rgba(0,255,136,0.05)';\n    ctx.lineWidth = 0.5;\n    var step = 50 / mapMeta.resolution * scale;  // every 50 cm real\n    for (var gx = offX; gx < cw; gx += step) { ctx.beginPath(); ctx.moveTo(gx,0); ctx.lineTo(gx,ch); ctx.stroke(); }\n    for (var gy = offY; gy < ch; gy += step) { ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(cw,gy); ctx.stroke(); }\n\n    // World \u2192 canvas pixel\n    var res = mapMeta.resolution;\n    var px  = offX + ((robot.x - mapMeta.origin_x) / res) * scale;\n    var py  = offY + ((mapMeta.height - (robot.y - mapMeta.origin_y) / res)) * scale;\n\n    var rr = Math.max(7, Math.min(14, 10 * scale / 2));\n\n    // Glow ring\n    ctx.shadowBlur = 14;\n    ctx.shadowColor = '#00ff88';\n    ctx.beginPath();\n    ctx.arc(px, py, rr + 3, 0, 2 * Math.PI);\n    ctx.strokeStyle = 'rgba(0,255,136,0.3)';\n    ctx.lineWidth = 3;\n    ctx.stroke();\n\n    // Robot body\n    ctx.beginPath();\n    ctx.arc(px, py, rr, 0, 2 * Math.PI);\n    ctx.fillStyle = '#00ff88';\n    ctx.fill();\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n\n    // Heading arrow\n    var yaw = robot.yaw;\n    var ax  = px + Math.cos(yaw)  * rr * 2.2;\n    var ay  = py - Math.sin(yaw)  * rr * 2.2;\n    ctx.beginPath();\n    ctx.moveTo(px, py);\n    ctx.lineTo(ax, ay);\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 2.5;\n    ctx.stroke();\n    // arrowhead\n    var alen = 5;\n    var angle = Math.atan2(-(ay - py), ax - px);\n    ctx.beginPath();\n    ctx.moveTo(ax, ay);\n    ctx.lineTo(ax - alen * Math.cos(angle - 0.4), ay + alen * Math.sin(angle - 0.4));\n    ctx.lineTo(ax - alen * Math.cos(angle + 0.4), ay + alen * Math.sin(angle + 0.4));\n    ctx.closePath();\n    ctx.fillStyle = '#ffffff';\n    ctx.fill();\n\n    ctx.shadowBlur = 0;\n\n    // Pose text\n    var info = document.getElementById('pose-info');\n    if (info) info.textContent =\n      'X: ' + robot.x.toFixed(3) + ' m   ' +\n      'Y: ' + robot.y.toFixed(3) + ' m   ' +\n      'Yaw: ' + (robot.yaw * 180 / Math.PI).toFixed(1) + '\u00b0';\n  }\n\n  /* \u2500\u2500 Receive msg from Node-RED \u2500\u2500 */\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    var p = msg.payload;\n\n    if (p.type === 'map') {\n      robot.x   = p.robot_x   || 0;\n      robot.y   = p.robot_y   || 0;\n      robot.yaw = p.robot_yaw || 0;\n      buildMapImage(p);\n      render();\n    } else if (p.type === 'pose') {\n      robot.x   = p.robot_x;\n      robot.y   = p.robot_y;\n      robot.yaw = p.robot_yaw;\n      render();\n    }\n  });\n})();\n</script>",
