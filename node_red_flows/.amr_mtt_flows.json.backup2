  {
    "id": "nav-wp-group",
    "type": "ui_group",
    "name": "Nav Waypoints",
    "tab": "amr-map-ui-tab",
    "order": 2,
    "disp": true,
    "width": "24",
    "collapse": false
  },
  {
    "id": "nav-wp-panel",
    "type": "ui_template",
    "z": "amr-map-tab",
    "group": "nav-wp-group",
    "name": "Nav Waypoints Panel",
    "order": 1,
    "width": "24",
    "height": "12",
    "format": "<style>#nw-wrap{background:#1a1a2e;padding:10px;border-radius:8px;font-family:monospace;color:#ccc}.nw-hdr{color:#4fc3f7;font-weight:bold;font-size:14px;margin-bottom:8px}.nw-pose{color:#00ff88;font-size:12px;margin-bottom:10px;min-height:16px}.nw-save-row{display:flex;gap:8px;margin-bottom:10px;align-items:center}.nw-save-row input{background:#2a2a3e;color:#fff;border:1px solid #555;border-radius:4px;padding:5px 8px;font-size:13px;flex:1;outline:none}.nw-save-row input:focus{border-color:#4fc3f7}.nw-btn{border:none;border-radius:4px;padding:5px 12px;cursor:pointer;font-size:12px;font-weight:bold}.btn-save{background:#00897b;color:#fff}.btn-go{background:#1565c0;color:#fff}.btn-del{background:#c62828;color:#fff;padding:5px 8px}.btn-cancel{background:#e65100;color:#fff}.nw-table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:10px}.nw-table th{color:#888;text-align:left;padding:4px 8px;border-bottom:1px solid #333}.nw-table td{color:#ccc;padding:4px 8px;border-bottom:1px solid #222;vertical-align:middle}.nw-table tr.active-row td{color:#00ff88;background:rgba(0,255,136,0.06)}.nw-footer{display:flex;align-items:center;gap:10px;font-size:12px}.st-idle{color:#888}.st-navigating{color:#ffd54f}.st-succeeded{color:#00ff88}.st-failed{color:#ef5350}.nw-empty{color:#555;text-align:center;padding:8px}</style><div id=\"nw-wrap\"><div class=\"nw-hdr\">Nav Waypoints</div><div class=\"nw-pose\" id=\"nw-pose\">Waiting for pose...</div><div class=\"nw-save-row\"><input id=\"nw-name\" type=\"text\" placeholder=\"Waypoint name e.g. HOME, PICK_A ...\" maxlength=\"32\" onkeydown=\"if(event.key==='Enter')nwSave()\"><button class=\"nw-btn btn-save\" onclick=\"nwSave()\">Save Waypoint</button></div><table class=\"nw-table\"><thead><tr><th>Name</th><th>X (m)</th><th>Y (m)</th><th>Yaw (deg)</th><th></th><th></th></tr></thead><tbody id=\"nw-tbody\"><tr><td class=\"nw-empty\" colspan=\"6\">Loading...</td></tr></tbody></table><div class=\"nw-footer\">Status: <span id=\"nw-status\" class=\"st-idle\">idle</span><button class=\"nw-btn btn-cancel\" onclick=\"nwCancel()\" style=\"margin-left:8px\">Cancel Nav</button></div></div><script>(function(){var BASE=\"http://localhost:5006\";function api(method,path,body){var opts={method:method,headers:{\"Content-Type\":\"application/json\"}};if(body!==undefined)opts.body=JSON.stringify(body);return fetch(BASE+path,opts).then(function(r){return r.json();});}window.nwSave=function(){var name=(document.getElementById(\"nw-name\").value||\"\").trim();if(!name){alert(\"Please enter a waypoint name\");return;}api(\"POST\",\"/save_waypoint\",{name:name}).then(function(r){if(r.status===\"ok\"){document.getElementById(\"nw-name\").value=\"\";poll();}else alert(\"Error: \"+r.status);}).catch(function(e){alert(\"Connection error: \"+e);});};window.nwGoto=function(name){api(\"POST\",\"/goto_waypoint\",{name:name}).then(function(r){if(r.status!==\"ok\")alert(\"Error: \"+r.status);poll();}).catch(function(e){alert(\"Connection error: \"+e);});};window.nwDelete=function(name){if(!confirm(\"Delete waypoint \\\"\"+name+\"\\\"?\"))return;api(\"DELETE\",\"/waypoint\",{name:name}).then(poll).catch(function(e){alert(\"Connection error: \"+e);});};window.nwCancel=function(){api(\"POST\",\"/cancel_nav\",{}).then(poll).catch(function(e){alert(\"Connection error: \"+e);});};function poll(){api(\"GET\",\"/status\").then(updateUI).catch(function(){document.getElementById(\"nw-pose\").textContent=\"Cannot connect to nav_waypoint_server (port 5006)\";var el=document.getElementById(\"nw-status\");el.textContent=\"offline\";el.className=\"st-failed\";});}function updateUI(data){var p=data.pose||{};var src=data.pose_source||\"?\";document.getElementById(\"nw-pose\").textContent=\"X: \"+(p.x||0).toFixed(3)+\"m  Y: \"+(p.y||0).toFixed(3)+\"m  Yaw: \"+(p.yaw||0).toFixed(1)+\"deg  [\"+src+\"]\";var ns=data.nav_status||\"idle\";var tgt=data.nav_target||\"\";var nsEl=document.getElementById(\"nw-status\");nsEl.textContent=ns+(tgt?\" -> \"+tgt:\"\");nsEl.className=\"st-\"+ns;var wps=data.waypoints||{};var names=Object.keys(wps).sort();var tbody=document.getElementById(\"nw-tbody\");tbody.innerHTML=\"\";if(names.length===0){var row=document.createElement(\"tr\");row.innerHTML=\"<td class=\\\"nw-empty\\\" colspan=\\\"6\\\">No waypoints yet. Drive robot to position and click Save.</td>\";tbody.appendChild(row);return;}names.forEach(function(name){var w=wps[name];var tr=document.createElement(\"tr\");if(data.nav_target===name)tr.className=\"active-row\";tr.innerHTML=\"<td><b>\"+name+\"</b></td>\"+\"<td>\"+(w.x||0).toFixed(3)+\"</td>\"+\"<td>\"+(w.y||0).toFixed(3)+\"</td>\"+\"<td>\"+(w.yaw||0).toFixed(1)+\"</td>\"+\"<td><button class=\\\"nw-btn btn-go\\\" onclick=\\\"nwGoto('\"+name+\"')\\\"\">Go</button></td>\"+\"<td><button class=\\\"nw-btn btn-del\\\" onclick=\\\"nwDelete('\"+name+\"')\\\"\">Del</button></td>\";tbody.appendChild(tr);});}setInterval(poll,2000);setTimeout(poll,500);}());</script>",
