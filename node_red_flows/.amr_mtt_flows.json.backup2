      ]
    ]
  },
  {
    "id": "ba73373851a0903d",
    "type": "comment",
    "z": "7f25b3b6ca73783f",
    "name": "\ud83e\uddbe UR5 Arm Control Dashboard \u2014 AMR MTT",
    "info": "\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e14 ENABLE ARM \u0e01\u0e48\u0e2d\u0e19\u0e16\u0e36\u0e07\u0e08\u0e30\u0e2a\u0e48\u0e07\u0e04\u0e33\u0e2a\u0e31\u0e48\u0e07\u0e44\u0e14\u0e49\n\u0e1b\u0e38\u0e48\u0e21 STOP \u0e17\u0e33\u0e07\u0e32\u0e19\u0e44\u0e14\u0e49\u0e40\u0e2a\u0e21\u0e2d\u0e42\u0e14\u0e22\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07 enable",
    "x": 240,
    "y": 40,
    "wires": []
  },
  {
    "id": "fc79040ebe60a474",
    "type": "inject",
    "z": "7f25b3b6ca73783f",
    "name": "Init: arm disabled",
    "props": [],
    "repeat": "",
