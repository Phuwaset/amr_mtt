  {
    "id": "761b4b059747ce3d",
    "type": "function",
    "z": "7f25b3b6ca73783f",
    "name": "parse status",
    "func": "var d=msg.payload;\nif(!d||!d.eef)return null;\nvar e=d.eef,q=d.joints;\nflow.set('jog_saved_slots',d.saved_slots||[]);\nreturn[\n{payload:'X: '+e.x.toFixed(4)+'  Y: '+e.y.toFixed(4)+'  Z: '+e.z.toFixed(4)},\n{payload:'Roll: '+e.roll.toFixed(1)+'\u00b0  Pitch: '+e.pitch.toFixed(1)+'\u00b0  Yaw: '+e.yaw.toFixed(1)+'\u00b0'},\n{payload:q.map(function(v,i){return 'J'+(i+1)+':'+v.toFixed(1)}).join('  ')},\n{payload:d.gripper_open?'\ud83d\udfe2 OPEN':'\ud83d\udd34 CLOSED'}\n];",
    "outputs": 4,
    "noerr": 0,
    "x": 560,
    "y": 1200,
    "wires": [
      [
        "e306b3a52128b018"
      ],
