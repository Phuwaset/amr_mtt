  {
    "id": "nav-wp-func-canvas",
    "type": "function",
    "z": "amr-map-tab",
    "name": "Format Waypoints for Canvas",
    "func": "if (!msg.payload || !msg.payload.waypoints) return null;\nvar wps = [];\nvar raw = msg.payload.waypoints;\nfor (var name in raw) {\n  wps.push({name: name, x: raw[name].x, y: raw[name].y, yaw: raw[name].yaw || 0});\n}\nmsg.payload = {type: 'waypoints', waypoints: wps, nav_target: msg.payload.nav_target || null};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 565,
    "y": 340,
    "wires": [
      [
        "ui-slam-map"
      ]
    ]
  }
]