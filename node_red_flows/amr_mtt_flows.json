        "name": "Preset: PRE_APPROACH",
        "func": "var joints = [-1.3963, -2.2689, -1.1519, -1.2217, 1.5708, 0.0];\nflow.set('joint_values', joints);\nvar cmd = {\n    \"op\": \"publish\",\n    \"topic\": \"/ur_arm_controller/joint_trajectory\",\n    \"type\": \"trajectory_msgs/JointTrajectory\",\n    \"msg\": {\n        \"header\": { \"stamp\": { \"sec\": 0, \"nanosec\": 0 }, \"frame_id\": \"\" },\n        \"joint_names\": [\"ur5_shoulder_pan_joint\",\"ur5_shoulder_lift_joint\",\"ur5_elbow_joint\",\"ur5_wrist_1_joint\",\"ur5_wrist_2_joint\",\"ur5_wrist_3_joint\"],\n        \"points\": [{\"positions\": joints, \"velocities\": [], \"accelerations\": [], \"effort\": [], \"time_from_start\": {\"sec\": 3, \"nanosec\": 0}}]\n    }\n};\nmsg.payload = JSON.stringify(cmd);\nreturn msg;",
