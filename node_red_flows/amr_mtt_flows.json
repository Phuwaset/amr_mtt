    {
        "id": "func-stop-arm",
        "type": "function",
        "z": "arm-control-tab",
        "name": "Build STOP Command",
        "func": "// STOP ไม่ต้องผ่าน guard — ทำงานได้เสมอ\nvar currentPositions = flow.get('feedback_positions') || [0,0,0,0,0,0];\n\nvar cmd = {\n    \"op\": \"publish\",\n    \"topic\": \"/ur_arm_controller/joint_trajectory\",\n    \"type\": \"trajectory_msgs/JointTrajectory\",\n    \"msg\": {\n        \"header\": { \"stamp\": { \"sec\": 0, \"nanosec\": 0 }, \"frame_id\": \"\" },\n        \"joint_names\": [\n            \"ur5_shoulder_pan_joint\",\n            \"ur5_shoulder_lift_joint\",\n            \"ur5_elbow_joint\",\n            \"ur5_wrist_1_joint\",\n            \"ur5_wrist_2_joint\",\n            \"ur5_wrist_3_joint\"\n        ],\n        \"points\": [{\n            \"positions\": currentPositions,\n            \"velocities\": [0,0,0,0,0,0],\n            \"accelerations\": [],\n            \"effort\": [],\n            \"time_from_start\": { \"sec\": 0, \"nanosec\": 100000000 }\n        }]\n    }\n};\nmsg.payload = JSON.stringify(cmd);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 390,
        "y": 580,
        "wires": [
            [
                "ws-arm-out"
            ]
        ]
    },
    {
        "id": "func-build-trajectory",
        "type": "function",
        "z": "arm-control-tab",
        "name": "Build JointTrajectory",
        "func": "var joints = flow.get('joint_values') || [0.0, -1.5708, -1.5708, -3.159, 0.0, 0.0];\nvar duration = parseFloat(flow.get('traj_duration') || 2.0);\n\nvar cmd = {\n    \"op\": \"publish\",\n    \"topic\": \"/ur_arm_controller/joint_trajectory\",\n    \"type\": \"trajectory_msgs/JointTrajectory\",\n    \"msg\": {\n        \"header\": { \"stamp\": { \"sec\": 0, \"nanosec\": 0 }, \"frame_id\": \"\" },\n        \"joint_names\": [\n            \"ur5_shoulder_pan_joint\",\n            \"ur5_shoulder_lift_joint\",\n            \"ur5_elbow_joint\",\n            \"ur5_wrist_1_joint\",\n            \"ur5_wrist_2_joint\",\n            \"ur5_wrist_3_joint\"\n        ],\n        \"points\": [{\n            \"positions\": joints,\n            \"velocities\": [],\n            \"accelerations\": [],\n            \"effort\": [],\n            \"time_from_start\": {\n                \"sec\": Math.floor(duration),\n                \"nanosec\": Math.round((duration % 1) * 1e9)\n            }\n        }]\n    }\n};\n\nmsg.payload = JSON.stringify(cmd);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 390,
        "y": 540,
        "wires": [
            [
                "func-arm-guard",
                "debug-send"
            ]
        ]
    },
