    <!-- ===================================================== -->
    <!-- โต๊ะสีขาว (Simple Box - ไม่มี Trimesh Collision)       -->
    <!-- ตำแหน่ง (-1.5, -0.5) ห่างจากหุ่น >= 0.45m           -->
    <!-- แขน UR5 เอื้อมถึง (0.5m จาก shoulder ที่ y≈-1.0)    -->
    <!-- ===================================================== -->
    <model name="pick_table">
      <static>true</static>
      <pose>-1.5 -0.5 0 0 0 0</pose>

      <!-- หน้าโต๊ะ: กว้าง 0.6m x ลึก 0.5m x หนา 0.03m สีขาว -->
      <link name="table_top">
        <pose>0 0 0.785 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.5 0.03</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.5 0.03</size></box>
          </geometry>
        </collision>
      </link>

      <!-- เสาโต๊ะ กลาง: 0.08x0.08x0.78m สีขาว -->
      <link name="leg_center">
        <pose>0 0 0.39 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.08 0.08 0.78</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.08 0.08 0.78</size></box>
          </geometry>
        </collision>
      </link>

      <!-- ฐานโต๊ะ: กว้าง 0.5m x ลึก 0.4m x หนา 0.03m -->
      <link name="table_base">
        <pose>0 0 0.015 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.4 0.03</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.4 0.03</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ===================================================== -->
    <!-- กล่องพัสดุ (Dynamic + ฟิสิกส์) วางบนหน้าโต๊ะ         -->
    <!-- z = 0.785 (table top center) + 0.015 (half top) +     -->
    <!--     0.05 (half box) = 0.85                            -->
    <!-- ===================================================== -->
    <model name="parcel_box">
      <pose>-1.5 -0.5 0.84 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0000833</iyy>
            <iyz>0</iyz>
            <izz>0.00006</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.76 0.60 0.42 1</ambient>
            <diffuse>0.76 0.60 0.42 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.08</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>10.0</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    	
    <light name="Warehouse_CeilingLight_003" type="point">
      <pose frame="">0 0 9 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>800</range>
        <constant>0.2</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <model name="ground_plane">
            <static>true</static>
           <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-3.90827 -4.65526 4.77216 0 0.623643 0.728194</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
