<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="payload_test">

    <!-- ── Lighting ──────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Physics ───────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- ── Ground Plane ──────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.88 0.88 0.85 1</ambient>
            <diffuse>0.88 0.88 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── เส้นแนวทาง 5 เมตร (visual only, ไม่มี collision) ──────────── -->
    <model name="path_line">
      <static>true</static>
      <pose>2.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <geometry><box><size>5.0 0.05 0.01</size></box></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- จุดเริ่มต้น (0, 0) -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- จุดสิ้นสุด (5, 0) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>5.0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Payload Boxes (วางที่สถานี pickup ด้านซ้าย) ──────────────── -->

    <!-- 50 kg — สีเขียว — สถานีซ้ายบน -->
    <model name="payload_box_50kg">
      <pose>-3.0 2.0 0.125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>0.635</ixx><iyy>0.635</iyy><izz>0.750</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="box_body">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <material>
            <ambient>0.10 0.65 0.10 1</ambient>
            <diffuse>0.15 0.75 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.1255 0 0 0</pose>
          <geometry><box><size>0.18 0.12 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 100 kg — สีส้ม — สถานีกลาง -->
    <model name="payload_box_100kg">
      <pose>-3.0 0.0 0.125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>100.0</mass>
          <inertia>
            <ixx>1.271</ixx><iyy>1.271</iyy><izz>1.500</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="box_body">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <material>
            <ambient>0.85 0.45 0.05 1</ambient>
            <diffuse>0.95 0.55 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.1255 0 0 0</pose>
          <geometry><box><size>0.18 0.12 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 150 kg — สีแดง — สถานีซ้ายล่าง -->
    <model name="payload_box_150kg">
      <pose>-3.0 -2.0 0.125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>150.0</mass>
          <inertia>
            <ixx>1.906</ixx><iyy>1.906</iyy><izz>2.250</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="box_body">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <material>
            <ambient>0.70 0.05 0.05 1</ambient>
            <diffuse>0.85 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="label">
          <pose>0 0 0.1255 0 0 0</pose>
          <geometry><box><size>0.18 0.12 0.002</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ── Delivery Station (จุดส่ง) ─────────────────────────────────── -->
    <!-- แท่นวางสีเทา ตำแหน่ง (3.0, 0.0) — waypoint เป้าหมาย -->
    <model name="delivery_station">
      <static>true</static>
      <pose>3.5 0.0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="platform">
          <geometry><box><size>0.8 0.8 0.10</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
        <!-- กรอบเหลืองแสดงจุด Drop-off -->
        <visual name="border_n">
          <pose>0 0.41 0.051 0 0 0</pose>
          <geometry><box><size>0.82 0.02 0.005</size></box></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
        <visual name="border_s">
          <pose>0 -0.41 0.051 0 0 0</pose>
          <geometry><box><size>0.82 0.02 0.005</size></box></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
        <visual name="border_e">
          <pose>0.41 0 0.051 0 0 0</pose>
          <geometry><box><size>0.02 0.82 0.005</size></box></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
        <visual name="border_w">
          <pose>-0.41 0 0.051 0 0 0</pose>
          <geometry><box><size>0.02 0.82 0.005</size></box></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
