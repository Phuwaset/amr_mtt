<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="payload_box_50kg">
    <link name="link">

      <!-- 50 kg  0.5×0.5×0.4 m -->
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <!-- ixx = m*(d²+h²)/12 = 50*(0.5²+0.4²)/12 -->
          <ixx>1.7083</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.7083</iyy>
          <iyz>0</iyz>
          <!-- izz = m*(w²+d²)/12 = 50*(0.5²+0.5²)/12 -->
          <izz>2.0833</izz>
        </inertia>
      </inertial>

      <!-- สีเขียว — บรรทุก 50 kg -->
      <visual name="box_body">
        <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        <material>
          <ambient>0.10 0.65 0.10 1</ambient>
          <diffuse>0.15 0.75 0.15 1</diffuse>
          <specular>0.05 0.15 0.05 1</specular>
        </material>
      </visual>

      <!-- แถบขาวบอกน้ำหนัก (top face) -->
      <visual name="label">
        <pose>0 0 0.2005 0 0 0</pose>
        <geometry><box><size>0.30 0.18 0.001</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
