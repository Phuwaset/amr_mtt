<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="training_box">
    <!-- กล่องพัสดุ: 6x6x8 cm, น้ำหนัก 0.1 kg -->
    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <!-- Inertia tensor: ixx=m*(h²+d²)/12, izz=m*(w²+d²)/12 -->
        <inertia>
          <ixx>0.0000833</ixx>  <!-- 0.1*(0.06²+0.08²)/12 -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000833</iyy>
          <iyz>0</iyz>
          <izz>0.00006</izz>   <!-- 0.1*(0.06²+0.06²)/12 -->
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.08</size>
          </box>
        </geometry>
        <material>
          <!-- สีน้ำตาลกล่องพัสดุ -->
          <ambient>0.76 0.60 0.42 1</ambient>
          <diffuse>0.76 0.60 0.42 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.06 0.06 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- ค่าแรงเสียดทานสูง เพื่อให้ Gripper จับได้ -->
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>10.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
