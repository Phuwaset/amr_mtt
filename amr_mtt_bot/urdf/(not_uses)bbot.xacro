<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_mtt_mesh_only">

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://amr_mtt_bot/meshes/amr_mtt_mesh.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://amr_mtt_bot/meshes/amr_mtt_mesh.dae" scale="1 1 1"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <!-- Approximate inertia for testing -->
            <mass value="60" />
            <inertia ixx="5.058" ixy="0" ixz="0"
                     iyy="9.562" iyz="0"
                     izz="13.720" />
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0 0.177" rpy="0 0 0.0" />
    </joint>

</robot>
